# HTTP listen address
HARADY_ADDR=:8080

# SQLite file path (dir is created automatically)
HARADY_DB_PATH=./data/harady.db

# Comma-separated list of allowed CORS origins (frontend URLs)
HARADY_CORS_ORIGINS=http://localhost:5173

# The one language this deployment speaks. Use any tag: be, en, pl, uk...
HARADY_LANGUAGE=be

# Rooms idle for longer than this are garbage-collected
HARADY_ROOM_IDLE_TTL=2h

HARADY_LOG_PATH=./data/harady.log
HARADY_LOG_LEVEL=info
HARADY_TURN_TIMEOUT=120s
HARADY_BOT_DELAY_MS=600

# ── Admin panel ────────────────────────────────────────────────────────────
# Comma-separated list of allowed admin emails. Only these can request a
# magic link. Must be non-empty for the panel to be usable.
HARADY_ADMIN_EMAILS=

# Base URL for building magic links. Leave empty to infer from the incoming
# request (recommended). Set explicitly only if behind a proxy that hides the
# original Host header.
HARADY_API_BASE_URL=

# Public URL of the frontend, used for the post-login redirect. Leave empty
# to use the first entry in HARADY_CORS_ORIGINS. In dev: http://localhost:5173.
# In prod: https://harady.juljan.by.
HARADY_ADMIN_BASE_URL=

# SMTP for magic-link delivery. Leave SMTP_HOST empty to log the link instead
# (useful for dev and initial VPS setup — tail harady.log to see it).
HARADY_SMTP_HOST=
HARADY_SMTP_PORT=587
HARADY_SMTP_USER=
HARADY_SMTP_PASS=
HARADY_SMTP_FROM=Harady <noreply@localhost>
