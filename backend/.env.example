# HTTP listen address
HARADY_ADDR=:8080

# SQLite file path (dir is created automatically)
HARADY_DB_PATH=./data/harady.db

# Comma-separated list of allowed CORS origins (frontend URLs)
HARADY_CORS_ORIGINS=http://localhost:5173

# The one language this deployment speaks. Use any tag: be, en, pl, uk...
HARADY_LANGUAGE=be

# Rooms idle for longer than this are garbage-collected
HARADY_ROOM_IDLE_TTL=2h

HARADY_LOG_PATH=./data/harady.log
HARADY_LOG_LEVEL=info
HARADY_TURN_TIMEOUT=120s
HARADY_BOT_DELAY_MS=600
